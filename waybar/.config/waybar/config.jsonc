{
  "layer": "top",
  "position": "top",
  "margin": "10px 10px 0px 10px",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "network",
    "battery#internal",
    "battery#external",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
        "active": "",
        "default": ""
    }
  },
  "hyprland/window": {
    "separate-outputs": true,
    "format": "{initialTitle}",
    "icon": true,
    "icon-size": 18
  },
  "clock": {
    "timezone": "Asia/Manila",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%m/%d - %H:%M}",
    "interval": 60,
    "on-click": "cal",
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "[░░░░░░░░░░] ",
    "format-icons": {
      "default": [
          "",
          "",
          ""
        ],
      // "[░░░░░░░░░░] ",
      // "[█░░░░░░░░░] ",
      // "[██░░░░░░░░] ",
      // "[███░░░░░░░] ",
      // "[████░░░░░░] ",
      // "[█████░░░░░] ",
      // "[██████░░░░] ",
      // "[███████░░░] ",
      // "[████████░░] ",
      // "[█████████░] ",
      // "[██████████] "
    },
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": {
        "default": [
          "🌑",
          "🌑",
          "🌒",
          "🌒",
          "🌒",
          "🌓",
          "🌓",
          "🌔",
          "🌔",
          "🌕",
          "🌕",
        ],
      // "[░░░░░░░░░░] 🌑",
      // "[█░░░░░░░░░] 🌑",
      // "[██░░░░░░░░] 🌒",
      // "[███░░░░░░░] 🌒",
      // "[████░░░░░░] 🌒",
      // "[█████░░░░░] 🌓",
      // "[██████░░░░] 🌓",
      // "[███████░░░] 🌔",
      // "[████████░░] 🌔",
      // "[█████████░] 🌕",
      // "[██████████] 🌕",
    },
  },
  "cpu": {
    "interval": 1,
    "format": " {usage:>2}%",
    "on-click": "wezterm start btop &",
  },
  "memory": {
    "interval": 30,
    "format": " {percentage}%",
    "on-click": "wezterm start btop &",
  },
  "network": {
    "format-wifi": "{icon} {bandwidthDownBits}",
    "format-icons": [
        " ",
        "⡇",
        "⣇",
        "⣧",
        "⣷",
        "⣿",
    ],
    "format-disconnected": "󰤠",
    "interval": 5,
    "tooltip": false,
    "on-click": "wezterm start nmtui &",
  },
  "battery#internal": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "max-length": 25,
    "on-click": "tlpui &",
  },
  "battery#external": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "max-length": 25,
    "on-click": "tlpui",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "⏻"
  }
}
