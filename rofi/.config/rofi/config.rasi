* {
    font: "JetBrainsMono Nerd Font 11";

    background: rgba(30, 20, 45, 100%);
    foreground: rgba(200, 170, 230, 100%);

    lightbg: rgba(45, 27, 61, 70%);
    separatorcolor: rgba(45, 27, 61, 100%);

    selected-normal-background: rgba(160, 100, 200, 25%);
    selected-normal-foreground: rgba(220, 190, 240, 100%);

    b-radius: 18px;
}

/* =========================================================
   WINDOW (mac-style floating panel)
   ========================================================= */

window {
    width: 380px;

    background-color: var(background);

    border: 1;
    border-color: var(separatorcolor);

    border-radius: 18px;

    padding: 10;
}

/* =========================================================
   MAIN (THIS CONTROLS OVERALL HEIGHT FEEL)
   ========================================================= */

mainbox {
    spacing: 6px;
    padding: 6;
}

/* =========================================================
   INPUT (mac search bar feel)
   ========================================================= */

inputbar {
    children: [ "prompt", "entry" ];
    spacing: 8px;

    background-color: var(lightbg);

    border: 1;
    border-color: var(separatorcolor);

    border-radius: 18px;

    padding: 8;
}

prompt {
    text-color: rgba(160, 100, 200, 100%);
}

entry {
    text-color: var(foreground);
    placeholder: "Search apps...";
    placeholder-color: rgba(160, 100, 200, 60%);
}

/* =========================================================
   LIST (THIS IS KEY FOR HEIGHT CONTROL)
   ========================================================= */

listview {
    spacing: 4px;

    lines: 6;              /* 👈 THIS controls height */
    fixed-height: true;

    scrollbar: false;
}

/* =========================================================
   ELEMENTS (compact mac rows)
   ========================================================= */

element {
    padding: 6px 10px;
    border-radius: 12px;
    text-color: var(foreground);
}

/* =========================================================
   SELECTED (mac highlight pill)
   ========================================================= */

element selected.normal {
    background-color: var(selected-normal-background);
    text-color: var(selected-normal-foreground);
}

/* =========================================================
   MESSAGE
   ========================================================= */

message {
    background-color: var(lightbg);

    border: 1;
    border-color: var(separatorcolor);

    border-radius: 18px;

    padding: 8;
}

textbox {
    text-color: var(foreground);
}
